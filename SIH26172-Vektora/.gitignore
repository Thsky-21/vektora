# SIH26172-Vektora — what is NOT committed from this folder.
# This file overrides the repo-root .gitignore for everything below it.

# --- re-include what the root .gitignore hides --------------------------------
# The trained models ARE part of this release (training/model, snapshots,
# the v0 Streamlit demo model).
!*.keras
!*.tflite

# --- environments / build output ----------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
node_modules/
console/dist/
firmware/build/
firmware/managed_components/
firmware/sdkconfig
firmware/sdkconfig.old
extras/*/build/
extras/*/managed_components/
extras/*/sdkconfig
extras/*/sdkconfig.old
extras/recorder/firmware/build/
extras/recorder/firmware/sdkconfig

# --- secrets (CLAUDE.md Rule 7) ------------------------------------------------
firmware/main/secrets.h

# --- third-party model download (55 MB, Apache-2.0, see server/README.md) ------
server/models/

# --- live room recordings from the laptop-mic page -----------------------------
# Whoever was in the room is on these. Their .jsonl logs are kept. Delete this
# line if everyone recorded agreed to publish.
sessions/*-mic*.wav

# --- OS / editor ------------------------------------------------------------------
.DS_Store
Thumbs.db
