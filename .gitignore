# Repo root. The project is SIH26172-Vektora/ (it has its own .gitignore).
# archive/ holds the pre-move tree, kept for history only.

# Python virtual environments (bare pattern matches at any depth)
.venv/
venv/
__pycache__/
*.py[cod]

# Bulk audio datasets -- never commit these (Speech Commands alone is ~2.3 GB)
speech_commands*/
*.tar.gz
*.zip

# Server-side ASR model dumps (vosk-model-*, hundreds of MB)
models/

# Generated feature arrays
*.npy
*.npz

# Trained models (regenerate from training scripts)
*.keras
*.h5
*.tflite

# Node
node_modules/
dist/

# OS / editor
.DS_Store
Thumbs.db
.claude/

# --- archive/: private recordings and local-only copies, never commit ---------
# (repo is public; these contain voices)
archive/demo/data/
archive/prototype/data/
archive/Human speech/
archive/sessions/
# Frozen model snapshots ARE committed (rollback points)
!archive/prototype/training/snapshots/**/*.keras
